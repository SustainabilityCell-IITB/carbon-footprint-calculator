# Used by `npm run build` (vite mode = production).

# Google Apps Script Web App URL (ends in /exec). This is where submissions go.
VITE_SHEET_URL=https://script.google.com/macros/s/AKfycbwbbo1cq0ifkXf0Hwr-42nNlFZfTALa4e6rUxST_BKQokSFGnOCGU5PxxtXq8lYAUI/exec

# Sub-path the calculator is served from. It lives in the "green-score" folder
# under the sustainabilitycell site, so this is /~sustainabilitycell/green-score/
# (leading ~, trailing slash). Must match the upload folder + the .htaccess.
VITE_BASE=/~sustainabilitycell/green-score/
