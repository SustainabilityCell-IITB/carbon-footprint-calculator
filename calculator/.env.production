# Used by `npm run build` (vite mode = production).
#
# VITE_SHEET_URL: the Google Apps Script Web App URL, ending in /exec.
#   Get it from google-apps-script/Code.gs step 4 (Deploy > Web app).
#   Example: https://script.google.com/macros/s/AKfycb.../exec
VITE_SHEET_URL=https://REPLACE_WITH_YOUR_APPS_SCRIPT_EXEC_URL

# VITE_BASE: sub-path the static site is served from on gymkhana.
#   Format is /~<your gymkhana username>/  (leading ~ and trailing slash).
VITE_BASE=/~sustainabilitycell/
